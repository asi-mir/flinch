# Copy this file to .env and fill in the values.

# Required to measure with the camera. Free trial key:
# https://physiology.presagetech.com/auth/register
# (You can also paste the key into the app instead.)
SMARTSPECTRA_API_KEY=

# Optional. Turns on the "Write AI notes" button in the report.
# Without it the app works the same, with no AI step and no data sent to Anthropic.
ANTHROPIC_API_KEY=
